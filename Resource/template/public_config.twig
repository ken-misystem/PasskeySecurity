<!doctype html>
<html lang="ja">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PasskeySecurity 設定</title>
    {% include '@PasskeySecurity/public_style.twig' %}
{% include '@PasskeySecurity/favicon.twig' %}</head>
<body>
<header>PasskeySecurity</header>
<main>
    <h1>パスキー・追加認証の設定</h1>
    <nav>
        <a href="{{ path('admin_store_plugin') }}">プラグイン一覧へ戻る</a>
        {% if ready %}
            <a href="{{ path('ps_member') }}">自分のパスキー・認証アプリを確認する</a>
        {% endif %}
    </nav>
    {% if message %}<p role="status" class="notice">{{ message }}</p>{% endif %}
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('ps_public_config') }}">
        <section>
            <h2>店舗の表示</h2>
            <label for="origin">この店舗のHTTPS URL</label>
            <input id="origin" name="origin" value="{{ origin }}" required{% if ready %} readonly{% endif %}>
            {% if ready %}
                <p>パスキーに登録済みのURLです。変更には移行手順が必要です。</p>
            {% else %}
                <p>例 https://shop.example.com</p>
            {% endif %}
            <label for="name">認証時に表示する店舗名</label>
            <input id="name" name="name" value="{{ name }}" maxlength="80" required>
        </section>
        <section>
            <h2>スタッフの追加認証</h2>
            {% if shop %}
                <p>すべてのスタッフの追加認証が必須です。</p>
            {% else %}
                <label><input type="checkbox" name="staff_required" value="1"{% if required %} checked{% endif %}>
                    すべてのスタッフの追加認証を必須にする</label>
                <p>未登録のスタッフは次回ログイン時に登録が必要になります。登録済みのスタッフの保護は継続します。</p>
            {% endif %}
            <label for="staff_session_hours">追加認証の保持時間</label>
            <select id="staff_session_hours" name="staff_session_hours" aria-describedby="staff_session_help">
                {% for hours in staff_session_options %}
                    <option value="{{ hours }}"{% if hours == staff_session_hours %} selected{% endif %}>{{ hours }}時間{% if hours == 1 %}（既定）{% endif %}</option>
                {% endfor %}
            </select>
            <p id="staff_session_help">日常の管理画面を利用できる時間を、追加認証を済ませた時点から数えます。EC-CUBEのセッションが先に切れた場合は、そこで再ログインが必要です。</p>
        </section>
        <section>
            <label for="password">現在の管理者パスワード</label>
            <input id="password" type="password" name="password" autocomplete="current-password" required>
            <button type="submit">設定を保存する</button>
        </section>
    </form>
</main>
</body>
</html>
